# Copy to .env and fill in. Never commit .env.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
BATTERYX_MONGODB_DB="batteryx"
# auto | mongo | sql
BATTERYX_DB_BACKEND="auto"
# Used only when the backend is sql (default sqlite:///./batteryx.db)
# BATTERYX_DATABASE_URL="sqlite:///./batteryx.db"

# AI assistant (optional; without it the assistant uses the rule-based requirement parser only)
GROQ_API_KEY="<your Groq key>"
GROQ_MODEL="openai/gpt-oss-120b"

# Claude engineering copilot (server-side only; never put this key in frontend code)
ANTHROPIC_API_KEY="<your Anthropic API key>"
BATTERYX_CLAUDE_MODEL="claude-opus-5-5"
# low | medium | high | xhigh | max  (Claude Opus 5.5 defaults to medium)
BATTERYX_CLAUDE_EFFORT="medium"
# 1 = server-side refusal fallback on (recommended)
BATTERYX_CLAUDE_FALLBACKS="1"

# Copilot provider: auto (Anthropic if ANTHROPIC_API_KEY is set, otherwise Groq via GROQ_API_KEY) | anthropic | groq
# BATTERYX_COPILOT_PROVIDER="auto"

# Max AI requests per client IP per minute (0 = unlimited)
BATTERYX_AI_RATE_PER_MIN="12"

# Deployed frontend origin(s) allowed to call this API (comma-separated, no trailing slash)
# BATTERYX_CORS_ORIGINS="https://your-frontend.vercel.app"
